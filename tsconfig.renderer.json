{
  "//": "화면 쪽(브라우저)은 getElementById가 늘 null일 수 있어 엄격 검사를 켜면 잡음만 남는다. 로직은 전부 main/shared에 있고 그쪽은 엄격하게 본다.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/renderer/**/*.js", "src/renderer/**/*.d.ts", "src/preload/**/*.js"]
}
